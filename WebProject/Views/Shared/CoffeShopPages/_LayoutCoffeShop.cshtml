@using WebProject.Service
@using WebProject.Enum
@using WebProject.Localizations
@inject IAuthService Auth
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "TropCoffee")</title>
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/coffeshop/style.css" />
    @await RenderSectionAsync("Styles", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>

<body class="@ViewData["BodyClass"]">
    <header>
        <a href="/CoffeShop" class="logo">
            <img src="/image/logo.png" alt="" />
        </a>
        <!-- Icons -->

        <i class="bx bx-menu" id="menu-icons"></i>
        <ul class="navbar">
            <li><a href="/CoffeShop#home">@CoffeShopPage.Index_HomeBtn</a></li>
            <li><a href="/CoffeShop#about">@CoffeShopPage.Index_AboutUs</a></li>
            <li><a href="/CoffeShop#products">@CoffeShopPage.Index_Product</a></li>
            <li><a href="/CoffeShop#customers">@CoffeShopPage.Index_Customers</a></li>
        </ul>
        <div class="header-icon">
            @if (Auth.IsAuthenticated())
            {
                var currentLang = Auth.GetLanguage();
                <div class="lang-switch" role="group" aria-label="Language">
                    <a class="lang-btn @(currentLang == Language.English ? "lang-btn--active" : "")"
                       asp-controller="User"
                       asp-action="ChangeLanguage"
                       asp-route-language="@Language.English">EN</a>
                    <a class="lang-btn @(currentLang == Language.Russian ? "lang-btn--active" : "")"
                       asp-controller="User"
                       asp-action="ChangeLanguage"
                       asp-route-language="@Language.Russian">RU</a>
                </div>
            }
            <i class="bx bxs-cart" id="cart-icons"></i>
            <i class="bx bx-search" id="search-icon"></i>
            @if (Auth.IsAuthenticated())
            {
                <a href="/User/Profile">
                    <i class="bx bx-user" id="user-icon">@Auth.GetUserName()</i>
                </a>
            }
            else
            {
                <a href="/Auth/Login">
                    <i class="bx bx-user" id="user-icon"></i>
                </a>
            }

        </div>
        <!-- Search -->
        <div class="search-box">
            <input type="search" name="" id="" placeholder=@CoffeShopPage.Index_Search />
        </div>
    </header>
    <div class="notificationcoffe-container">
        <div class="messagenotification templates">Example</div>
    </div>
    @RenderBody()
    <!-- Footer -->
    <section class="footer">
        <div class="footer-box">
            <h2>TropCoffee</h2>
            <p>
                Lorem, ipsum dolor sit amet consectetur adipisicing elit. Maxime,
                totam?
            </p>
            <div class="social">
                <a href="#"><i class="bx bxl-instagram"></i></a>
                <a href="#"><i class="bx bxl-tiktok"></i></a>
                <a href="#"><i class="bx bxl-facebook"></i></a>
                <a href="#"><i class="bx bxl-youtube"></i></a>
                <a href="#"><i class="bx bxl-linkedin"></i></a>
            </div>
        </div>
        <div class="footer-box">
            <h3>@CoffeShopPage.Index_Support</h3>
            <li><a href="#">Product</a></li>
            <li><a href="#">@CoffeShopPage.Index_AboutUs</a></li>
            <li><a href="#">Help and Support</a></li>
        </div>
        <div class="footer-box">
            <h3>View Guides</h3>
            <li><a href="#">Partners</a></li>
            <li><a href="#">Careers</a></li>
            <li><a href="#">Our Branches</a></li>
        </div>
        <div class="footer-box">
            <h3>Contact</h3>
            <div class="contact">
                <span><i class="bx bxs-map"></i>124503, Minsk, st. Malanka,9</span>
                <span><i class="bx bx-phone"></i>+375 (29) 111-11-11</span>
                <span><i class="fa-solid fa-envelope"></i>tropcoff@shop.com</span>
            </div>
        </div>
    </section>
    <div class="copyright">
        <p>&#169; @DateTime.Now.Year TropCoffee. All rights reserved.</p>
    </div>
    <!-- Add script  -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
    <script src="~/js/common_con.js"></script>
    <script src="~/js/coffeshop/script.js"></script>
    <script src="~/js/userpage/comments.js"></script>
    <script src="~/js/home/notification.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
