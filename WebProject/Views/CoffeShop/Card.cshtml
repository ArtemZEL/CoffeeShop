@model WebProject.Models.CoffeeShop.ProductCardViewModel
@{
    Layout = "CoffeShopPages/_LayoutCoffeShop";
    ViewData["Title"] = Model.Title;
    ViewData["BodyClass"] = "product-card-page";
}

<article class="product-card" data-product-card>
    <nav class="product-card__breadcrumb" aria-label="Категория">
        <span>@Model.RootCategory</span>
        <span class="product-card__breadcrumb-sep">/</span>
        <span>@Model.Category</span>
        <span class="product-card__breadcrumb-sep">/</span>
        <span>@Model.Name</span>
    </nav>

    <div class="product-card__grid">
        <div class="product-card__media">
            <img src="@Model.ImageUrl" alt="@Model.Title" />
        </div>

        <div class="product-card__info">
            <h1 class="product-card__title">@Model.Title</h1>

            <div class="product-card__weight-badge">
                <i class="bx bx-coffee-togo" aria-hidden="true"></i>
                <span>@Model.PackWeight</span>
            </div>

            <div class="product-card__text">
                @foreach (var paragraph in Model.Description)
                {
                    <p>@paragraph</p>
                }
            </div>

            <h2 class="product-card__subtitle">Условия заказа</h2>
            <div class="product-card__text product-card__text--terms">
                @foreach (var term in Model.OrderTerms)
                {
                    <p>@term</p>
                }
            </div>

            <div class="product-card__price-block">
                <span class="product-card__price-label">за пачку</span>
                <div class="product-card__price">@Model.Price.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) р.</div>
            </div>

            <label class="product-card__field">
                <span>Вес пачки:</span>
                <select name="weight" aria-label="Вес пачки">
                    @foreach (var weight in Model.Weights)
                    {
                        <option value="@weight">@weight</option>
                    }
                </select>
            </label>

            <label class="product-card__field">
                <span>Помол:</span>
                <select name="grind" aria-label="Помол">
                    @foreach (var grind in Model.Grinds)
                    {
                        <option value="@grind">@grind</option>
                    }
                </select>
            </label>

            <div class="product-card__actions">
                <div class="product-card__qty" data-qty>
                    <button type="button" class="product-card__qty-btn" data-qty-minus aria-label="Уменьшить">−</button>
                    <input type="number" name="quantity" value="@Model.Quantity" min="1" max="99" inputmode="numeric" data-qty-value />
                    <button type="button" class="product-card__qty-btn" data-qty-plus aria-label="Увеличить">+</button>
                </div>
                <button type="button" class="product-card__cart-btn">Добавить в корзину</button>
            </div>
        </div>
    </div>
</article>

@section Styles {
    <link rel="stylesheet" href="~/css/coffeshop/product-card.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/coffeshop/product-card.js" asp-append-version="true"></script>
}
