@model WebProject.Models.CoffeShopViewModel
@using WebProject.Localizations
@{
    Layout = "CoffeShopPages/_LayoutCoffeShop";
}

<section class="home" id="home">
    <div class="home-text">
        <h1>
            @CoffeShopPage.Index_Slogan
        </h1>
        <p>
            Lorem ipsum dolor sit amet consectetur, adipisicing elit. Pariatur
            dolor explicabo deleniti magnam dicta consequatur.
        </p>
        <a href="#" class="btn">Shop</a>
    </div>
    <div class="home-img">
        <img src="/image/Group 31.png" alt="" />
    </div>
</section>
<!-- About -->
<section class="about" id="about">
    @{
        var sliderImages = Model.LayoutModelUser?.ImageFon ?? new List<string>();
    }
    <div class="about-img">
        @if (sliderImages.Count > 0)
        {
            <div id="aboutCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @for (int i = 0; i < sliderImages.Count; i++)
                    {
                        var img = sliderImages[i];
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@img" class="d-block w-100 rounded" alt="coffee image @(i + 1)" />
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#aboutCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Назад</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#aboutCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Вперёд</span>
                </button>
            </div>
        }
        else
        {
            <img src="~/image/about.jpg" alt="" />
        }
    </div>
    <div class="about-text">
        <h2>@CoffeShopPage.Index_OurHistory</h2>
        <p>
            Lorem ipsum dolor sit amet consectetur adipisicing elit. Rem et ipsum
            aperiam ullam corrupti eveniet, architecto doloribus non fuga
            voluptatem.
        </p>
        <p>
            Lorem ipsum dolor sit amet consectetur adipisicing elit. Rem et ipsum
            aperiam ullam corrupti eveniet, architecto doloribus non fuga
            voluptatem.
        </p>
        <p>
            Lorem ipsum dolor sit amet consectetur adipisicing elit. Nulla
            deserunt blanditiis et at delectus?
        </p>
        <a href="#" class="btn"> Learn More </a>
    </div>
</section>

<!-- Products -->
<section class="products" id="products">
    <div class="heading">
        <h2>Our popular products</h2>
    </div>
    <!-- Container -->
    <!-- This a minimal API hided -->
    <div class="products-container coffe-minimal-api">
        <div class="box templatescoffee" data-id="-1">
            <img src="" />
            <h3>
                <div class="editable-title">
                    <span class="view mode"></span>
                </div>
            </h3>
            <div class="content">
                <span>$0</span>
                <a href="#">Buy</a>
            </div>
        </div>
    </div>

    <div class="products-container">
        @foreach (var product in Model.CoffeeProducts)
        {
            <div class="box">
                <a href="/Coffee/Brazilian/Name">
                    <img src="@product.Img" alt="" />
                    <h3>@product.Name</h3>
                </a>
                <div class="content">
                    <span>$@product.Cell</span>
                    <a href="/Coffee/Brazilian/Name">Buy</a>
                </div>
            </div>
        }
    </div>
    <div class="show-more-container">
        <a href="#" class="show-more-link">Show More</a>
    </div>
</section>
<!-- Customers -->
<section class="customers" id="customers">
    <div class="heading">
        <h2>Our Customer's</h2>
    </div>
    <!-- Customers MINIMAL API -->
    <div class="customers-container usercomments-minimal-api">
        <div class="box templatesuser">
            <img src="" alt="User Image" />
            <h2></h2>
            <p></p>
        </div>
    </div>
    <!-- Container -->
    <div class="customers-container">
        @foreach (var userComments in Model.UserComments)
        {
            <div class="box">
                <img src="@(string.IsNullOrEmpty(userComments.Img) ? "/image/default.jpg" : userComments.Img)" alt="User Image" />
                <h2>@userComments.Name</h2>
                <p>
                    @userComments.Comments
                </p>
            </div>
        }

    </div>
</section>
