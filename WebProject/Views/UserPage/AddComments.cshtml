@model WebProject.Models.Users.UserCommentViewModel

@{
    Layout = "CoffeShopPages/_LayoutCoffeShopTestPage";
}

<div class="add-comment">

    <h2>Add Your Comment</h2>

    <div class="customers-container">

        <div class="box">

            <img src="@(Model?.Img ?? "/image/default.jpg")"
                 alt="User Image" />

            <h3>@(Model?.Name ?? "Guest")</h3>

            <form asp-controller="UserPage"
                  asp-action="Add"
                  method="post">

                @Html.AntiForgeryToken()

                <textarea asp-for="Comments"
                          placeholder="Write your comment..."
                          rows="3"></textarea>

                <button type="submit" class="btn">
                    Send Comment
                </button>

            </form>

        </div>

    </div>

</div>