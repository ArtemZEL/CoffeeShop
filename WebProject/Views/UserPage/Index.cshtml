@model WebProject.Models.Users.UserPageViewModel

@{
    Layout = "CoffeShopPages/_LayoutCoffeShopTestPage";
}

<div>
    Hello @Model.Name
</div>

<div>
    <a href="/UserPage/AddComments">
        Add Comment's
    </a>
</div>

<div class="customers-container">

    @if (Model.UserComments != null && Model.UserComments.Any())
    {
        foreach (var comment in Model.UserComments)
        {
            <div class="box">

                <img src="@comment.Img"
                     alt="User Image" />

                <h3>@comment.Name</h3>

                <p>
                    @comment.Comments
                </p>

                <form asp-controller="UserPage"
                      asp-action="Delete"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@comment.Id" />

                    <button type="submit" class="btn">
                        Delete
                    </button>

                </form>

            </div>
        }
    }
    else
    {
        <p>You haven't written any comments yet.</p>
    }

</div>