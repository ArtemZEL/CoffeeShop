@using WebProject.Models
@model CoffeShopViewModel

@{
    Layout = "CoffeShopPages/_LayoutCoffeShopTestPage";
}

@section Scripts {
    <script src="/js/coffeshop/CoffeePage.js"></script>
}


<section class="products" id="products">
    <div class="heading">
        <a class = "" href="/CoffeShop/LoginPageTest"></a>
        <h2>Product's page'</h2>
    </div>

    <div class="products-container">
        @if (Model?.CoffeeProducts != null && Model.CoffeeProducts.Any())
        {
            foreach (var coffee in Model.CoffeeProducts)
            {
                <div class="box">
                    <img src="@coffee.Img" alt="@coffee.Name" />
                    <h3 class="name-products">@coffee.Name</h3>
                    <p class="author">Added by: @coffee.AuthorName</p>
                    <p class="category">Category: @coffee.CategoryName</p>
                    <div class="content">
                        <span class="cell">$@coffee.Cell</span>
                        @if (coffee.CanFindPage)
                        {
                            <a href="/AdminPage/RemoveCoffee?id=@coffee.Id">Remove</a>               
                            <a href="/AdminPage/EditCoffee?id=@coffee.Id">Edit</a>
                        }
                        @**@
                    </div>
                </div>
            }
        }
        else
        {
            <p>No coffee products available yet.</p>
        }
    </div>
</section>