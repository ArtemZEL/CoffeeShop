@{
    Layout = "CoffeShopPages/_LayoutCoffeShopTestPage";
}

@using WebProject.Service
@inject AuthService Auth

@using WebProject.Localizations


<div>
    Hello @(Auth.IsAuthenticated() ? Auth.GetUserName() : "Guest")
    
    @if (Auth.IsAdmin())
    {
        <div>
            <a href="/AdminPage/AddPageCoffee">
                @AdminPage.Index_Button_Add
            </a>
        </div>
        <div>
            <a href="/AdminPage/AddingCoffee">
                @AdminPage.Index_Button_Adding_Coffee
            </a>
        </div>
        <div>
            <a href="/AdminPage/AddCategory">
                @AdminPage.Index_Button_Adding_Category
            </a>
        </div>
        <div>
            <a href="/AdminPage/AllAvatarsUser">
                All User 
            </a>
        </div>
        <div>
            <a href="/AdminPage/ManageGallery">
                Slider
            </a>
        </div>
    }
    
</div>
