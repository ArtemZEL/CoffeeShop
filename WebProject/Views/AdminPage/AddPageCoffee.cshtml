@model CoffeeProductViewModel

@{
    Layout = "CoffeShopPages/_LayoutCoffeShopTestPage";
}

<div>
    <h2>Add Page</h2>

    <form action="/AdminPage/Add" method="post">
        <div>
            <input type="text" name="Name" placeholder="Add Name coffee" />
        </div>
        <div>
            <input type="text" name="Img" placeholder="Add Url Image coffee" />
        </div>
        <div>
            <input type="text" name="Cell" placeholder="Add Price" />
        </div>
        <div>
            @Html.DropDownListFor(x => x.CategoryId, Model.AllCategory)
        </div>

        <button class="btn">Add New Coffee</button>
    </form>
</div>
