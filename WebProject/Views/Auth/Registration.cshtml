@model WebProject.Models.Users.UserViewModel

@{
    Layout = "CoffeShopPages/_LayoutCoffeShopTestPage";
}

@section Scripts {
    <script src="/js/auth/registration.js"></script>
}
<div>
    <form method="post">
        <div>
            UserName: @Html.TextBoxFor(x=>x.UserName)
            @Html.ValidationMessageFor(x => x.UserName)
        </div>
        <div>
            Email: @Html.TextBoxFor(x=>x.Email)
            @Html.ValidationMessageFor(x => x.Email)

        </div>
        <div>
            Password: @Html.TextBoxFor(x=>x.Password)
            @Html.ValidationMessageFor(x => x.Password)
        </div>
        @* <div>
            Avatar: @Html.TextBoxFor(x=>x.AvatarUrl)
        </div> *@
        <div>
            <button class="btn">Registration</button>
        </div>
    </form>
</div>

